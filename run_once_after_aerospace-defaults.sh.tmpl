#!/bin/bash

# The two macOS defaults AeroSpace needs
# Split out of macos-defaults.sh, which wants sudo and killalls half the
# desktop. This one writes two keys and nothing else, so it is safe to run
# whenever.

set -e

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
log_info() {
    echo -e "${BLUE}[AEROSPACE-DEFAULTS]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[AEROSPACE-DEFAULTS]${NC} $1"
}

log_info "Writing the macOS defaults AeroSpace depends on..."

# Turn off "Displays have separate Spaces". AeroSpace is more stable without
# it, since the Apple APIs it uses are not Spaces-aware.
defaults write com.apple.spaces spans-displays -bool true

# AeroSpace parks hidden windows in a screen corner, which makes Mission
# Control draw everything tiny. Grouping by application works around it.
defaults write com.apple.dock expose-group-apps -bool true

log_success "Done. Both settings need a logout to take effect."
