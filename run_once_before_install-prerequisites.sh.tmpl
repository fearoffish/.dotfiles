#!/bin/bash

# Install prerequisites: Homebrew, 1Password CLI, and essential packages
# This runs once before dotfiles are applied

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
log_info() {
    echo -e "${BLUE}[PREREQUISITES]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[PREREQUISITES]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[PREREQUISITES]${NC} $1"
}

log_error() {
    echo -e "${RED}[PREREQUISITES]${NC} $1"
}

# Check if command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

log_info "Installing prerequisites..."

###############################################################################
# Install Homebrew
###############################################################################

if command_exists brew; then
    log_info "Homebrew already installed"
else
    log_info "Installing Homebrew..."

    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

    log_success "Homebrew installed successfully"
fi

###############################################################################
# Install essential packages
###############################################################################

log_info "Installing essential packages..."

if command_exists brew; then
    brew install git curl wget || log_warning "Some essential packages may have failed to install"
fi

log_success "Essential packages installed"

###############################################################################
# Install 1Password CLI
###############################################################################

if command_exists op; then
    log_info "1Password CLI already installed"
else
    log_info "Installing 1Password CLI..."

    if command_exists brew; then
        brew install --cask 1password-cli || log_warning "1Password CLI installation failed"
    else
        log_warning "Homebrew not found, skipping 1Password CLI installation"
    fi

    if command_exists op; then
        log_success "1Password CLI installed successfully"
    else
        log_warning "1Password CLI installation may have failed"
    fi
fi

###############################################################################
# Xcode command line tools
###############################################################################

# Install Xcode command line tools if not installed
if ! xcode-select -p >/dev/null 2>&1; then
    log_info "Installing Xcode command line tools..."
    xcode-select --install || log_warning "Xcode command line tools installation may have failed"
fi

log_success "Prerequisites installation complete!"
