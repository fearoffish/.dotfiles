#!/bin/bash

# Amethyst draws no active-window highlight of its own, so JankyBorders keeps
# the focus indicator. Colours were shared with SketchyBar's colors.sh until
# SketchyBar went; they are Catppuccin Mocha blue on transparent, and no
# longer follow the system light/dark switch.

options=(
  style=round
  width=7.5
  hidpi=on
  active_color=0xff8aadf4
  background_color=0x00000000
  blacklist="CleanShot,Tuna"
)

borders "${options[@]}"
